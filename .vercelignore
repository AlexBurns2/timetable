# Kept in the repo, never deployed: notes for whoever works on the site, and
# old copies of pages. These name the people behind the site.
*.md
index2.html
backup
graphify-out
.preview

# Tooling folders and files that the site never loads.
.agents
.claude
skills-lock.json
tools

# Design source files: they carry the name of the computer account that made
# them in their metadata, and no page uses them (the PNG and SVG exports are
# what the site shows).
images/*.ai

# 3D source files: a .blend carries the folder paths of the computer it was
# made on, and the site loads only the .glb made from it (tools/synth/cinema.py).
models/**/*.blend
models/**/*.blend1
