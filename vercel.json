{
  "crons": [
    {
      "path": "/api/daily-generate",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/poll",
      "destination": "/api/forum?og=1"
    },
    {
      "source": "/beta/",
      "destination": "/andre/index.html"
    },
    {
      "source": "/beta/:path*",
      "destination": "/andre/:path*"
    },
    {
      "source": "/vault",
      "destination": "/vault.html"
    },
    {
      "source": "/q/:code",
      "destination": "/q.html"
    },
    {
      "source": "/q",
      "destination": "/q.html"
    }
  ],
  "redirects": [
    {
      "source": "/beta",
      "destination": "/beta/",
      "permanent": false
    }
  ]
}
